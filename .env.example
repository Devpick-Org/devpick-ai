# DevPick AI environment example

# App
APP_ENV=development
SERVER_PORT=8000

# MongoDB - internal (docker network) example
# Use this when the app runs inside devpick-infra docker network (host is 'mongodb')
MONGO_DB=devpick
MONGO_URI=mongodb://devpick:your_mongo_password_here@mongodb:27017/devpick?authSource=admin

# MongoDB - localhost example (when running scripts locally on your PC)
# MONGO_URI=mongodb://devpick:your_mongo_password_here@localhost:27017/devpick?authSource=admin

# LLM keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional OpenAI key
# OPENAI_API_KEY=your_openai_api_key_here
